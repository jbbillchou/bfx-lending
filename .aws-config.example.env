# AWS ECS deploy 設定（選用）
# 自架若不部署到 AWS，整個檔案可忽略。要用再複製成 .aws-config.env 並填入你自己的值。

AWS_REGION=ap-northeast-1
ECR_REGISTRY=<your_account_id>.dkr.ecr.<region>.amazonaws.com
ECR_REPOSITORY=bfx-lending
ECS_CLUSTER=bfx-lending
ECS_SERVICE=bfx-lending-service

# 部署前自動 bump VERSION patch
BUMP_VERSION=true

# 部署完同時更新本機 docker compose
LOCAL_DOCKER_COMPOSE=true
